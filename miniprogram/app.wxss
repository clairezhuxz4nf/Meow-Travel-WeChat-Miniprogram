page {
  background: #F7F4EE;
  color: #2E3130;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
}

button {
  font: inherit;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 32rpx 180rpx;
}

.page-title {
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.2;
}

.page-subtitle {
  color: #686A67;
  font-size: 26rpx;
  margin-top: 8rpx;
}

.card {
  background: #FFFCF7;
  border: 2rpx solid #DED9D0;
  border-radius: 28rpx;
  box-sizing: border-box;
}

.section {
  margin-top: 44rpx;
}

.section-heading {
  align-items: center;
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 650;
}

.section-action {
  color: #6F91A5;
  font-size: 26rpx;
}

.pill {
  align-items: center;
  background: #F0ECE5;
  border-radius: 999rpx;
  color: #535653;
  display: inline-flex;
  font-size: 24rpx;
  min-height: 52rpx;
  padding: 0 20rpx;
}

.status-confirmed {
  background: #E6EEE3;
  color: #4E7354;
}

.status-warning {
  background: #F5EBD7;
  color: #8B652C;
}

.primary-button {
  align-items: center;
  background: #D96A60;
  border-radius: 999rpx;
  color: #FFFCF7;
  display: flex;
  font-size: 30rpx;
  font-weight: 600;
  height: 92rpx;
  justify-content: center;
  line-height: 92rpx;
}

.secondary-button {
  align-items: center;
  background: #FFFCF7;
  border: 2rpx solid #D8D3CB;
  border-radius: 999rpx;
  color: #2E3130;
  display: flex;
  font-size: 28rpx;
  height: 80rpx;
  justify-content: center;
  line-height: 80rpx;
}

.muted {
  color: #686A67;
}

.divider {
  background: #E4DFD7;
  height: 2rpx;
  margin: 24rpx 0;
}

.pressable {
  transition: opacity 120ms ease, transform 120ms ease;
}

.pressable:active {
  opacity: 0.78;
  transform: scale(0.985);
}

