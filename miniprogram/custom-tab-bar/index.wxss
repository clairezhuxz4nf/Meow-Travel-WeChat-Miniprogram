.tab-shell {
  bottom: 0;
  box-sizing: border-box;
  left: 0;
  padding: 0 24rpx calc(16rpx + env(safe-area-inset-bottom));
  position: fixed;
  right: 0;
  z-index: 999;
}

.tab-inner {
  align-items: stretch;
  background: rgba(255, 252, 247, 0.97);
  border: 2rpx solid #DED9D0;
  border-radius: 30rpx;
  box-shadow: 0 12rpx 36rpx rgba(46, 49, 48, 0.1);
  display: flex;
  height: 112rpx;
  justify-content: space-around;
  overflow: hidden;
}

.tab-item {
  align-items: center;
  color: #747672;
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  position: relative;
}

.tab-item--active {
  color: #2E3130;
}

.tab-icon {
  align-items: center;
  display: flex;
  font-size: 32rpx;
  font-weight: 600;
  height: 38rpx;
  justify-content: center;
  line-height: 38rpx;
}

.tab-text {
  font-size: 23rpx;
  font-weight: 550;
  margin-top: 6rpx;
}

.active-mark {
  background: #D96A60;
  border-radius: 999rpx;
  bottom: 6rpx;
  height: 6rpx;
  position: absolute;
  width: 34rpx;
}

