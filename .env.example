# Browser-visible proxy URL only. Never put a Gemini API key in a VITE_ variable.
VITE_AI_PLACES_ENDPOINT=https://your-worker.example.workers.dev/api/ai/places

# Local Vite server only; keep this in .env.local and out of Git.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Existing optional integrations.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_OPENROUTESERVICE_API_KEY=
